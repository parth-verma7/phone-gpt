{
  "expo": {
    "name": "PhoneGPT",
    "slug": "phone-gpt",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.phonegpt.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-build-properties",
      [
        "llama.rn",
        {
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ]
    ],
    "icon": "./assets-phonegpt-icon.png"
  }
}
