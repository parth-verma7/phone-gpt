{
  "expo": {
    "name": "PhoneGPT",
    "slug": "phone-gpt",
    "version": "0.3.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.phonegpt.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-build-properties",
      [
        "llama.rn",
        {
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ]
    ]
  }
}
