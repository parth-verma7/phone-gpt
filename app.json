{
  "expo": {
    "name": "PhoneGPT",
    "slug": "phone-gpt",
    "version": "0.5.13",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.phonegpt.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-build-properties",
      [
        "llama.rn",
        {
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false,
          "enableEntitlements": false
        }
      ],
      "./plugins/withPhoneGptIOS"
    ],
    "icon": "./assets-phonegpt-icon.png",
    "ios": {
      "bundleIdentifier": "com.phonegpt.app",
      "buildNumber": "27",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PhoneGPT records your voice to transcribe it locally on your device.",
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    }
  }
}
