{
  "name": "phone-gpt",
  "version": "0.5.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client --lan --scheme exp+phone-gpt-dev --port 8083",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:voice": "node --test tests/voice.test.cjs",
    "build:android:standalone": "APP_VARIANT=production NODE_ENV=production ./android/gradlew -p android :app:assembleRelease -PreactNativeArchitectures=arm64-v8a -PrnllamaVariants=rnllama,rnllama_v8_2 --console=plain",
    "test": "node --test tests/*.test.cjs",
    "start:dev": "APP_VARIANT=development expo start --dev-client --lan --scheme exp+phone-gpt-dev --port 8083",
    "build:android:dev": "APP_VARIANT=development NODE_ENV=development ./android/gradlew -p android :app:assembleDebug -PreactNativeArchitectures=arm64-v8a -PrnllamaVariants=rnllama,rnllama_v8_2 --console=plain"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "6.0.3",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "llama.rn": "^0.13.0-rc.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "whisper.rn": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  }
}
